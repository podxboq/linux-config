conky.config = {
    background = true,
    update_interval = 1,

    cpu_avg_samples = 2,
    net_avg_samples = 2,
    temperature_unit = 'celsius',

    double_buffer = true,
    no_buffers = true,
    text_buffer_size = 2048,

    gap_x = 10,
    gap_y = 30,
    minimum_width = 190,
    minimum_height = 450,
    maximum_width = 190,

    own_window = true,
    own_window_type = 'normal',
    own_window_argb_visual = true,
    own_window_argb_value = 160,
    own_window_colour = '000000',
    own_window_hints = 'undecorated,sticky,skip_taskbar,skip_pager,below',
    border_inner_margin = 5,
    border_outer_margin = 0,
    alignment = 'top_right',

    draw_shades = false,
    draw_outline = false,
    draw_borders = false,
    draw_graph_borders = false,

    use_xft = true,
    font = 'Source Sans 3:size=8',
    xftalpha = 1.0,
    uppercase = false,

    default_color = '#FFFFFF',
    color1 = '#DDDDDD',
    color2 = '#AAAAAA',
    color3 = '#888888',
    color4 = '#EF5A29',
}

conky.text = [[
${alignc}${color4}${font Source Sans 3:bold:size=28}${time %H:%M}${font}${color}
${alignc}${color1}${font Source Sans 3:size=10}${time %A, %e de %B}${font}${color}

${color4}${font Source Sans 3:bold:size=9}CPU  ${color3}${font Source Sans 3:size=8}${hwmon coretemp temp 1}°C${alignr}${color1}${cpu cpu0}%${font}${color}
${color4}${hr 1}${color}
${color1}${top name 1}${alignr}${color2}${top cpu 1}%
${color1}${top name 2}${alignr}${color2}${top cpu 2}%
${color1}${top name 3}${alignr}${color2}${top cpu 3}%
${color4}${cpugraph cpu0 24,180 EF5A29 aa3311}${color}
${color3}${threads} hilos

${color4}${font Source Sans 3:bold:size=9}MEM${alignr}${color1}${font Source Sans 3:size=8}${mem} / ${memmax}${font}${color}
${color4}${hr 1}${color}
${color4}${membar 5,180}${color}
${color1}${top_mem name 1}${alignr}${color2}${top_mem mem 1}%
${color1}${top_mem name 2}${alignr}${color2}${top_mem mem 2}%
${color1}${top_mem name 3}${alignr}${color2}${top_mem mem 3}%

${color4}${font Source Sans 3:bold:size=9}DISCO${alignr}${color1}${font Source Sans 3:size=8}${fs_used /} / ${fs_size /}${font}${color}
${color4}${hr 1}${color}
${color4}${fs_bar 5,180 /}${color}
${color4}${diskiograph nvme0n1 24,180 EF5A29 aa3311}${color}

${color4}${font Source Sans 3:bold:size=9}NET${font}${color}
${color4}${hr 1}${color}
${color1}${wireless_essid wlo1}${alignr}${color2}${wireless_link_qual_perc wlo1}%
${color4}${wireless_link_bar 5,180 wlo1}${color}
${color2}▼ ${color1}${downspeed wlo1}${alignr}${color2}▲ ${color1}${upspeed wlo1}
${color3}${addr wlo1}

${color4}${font Source Sans 3:bold:size=9}BATERÍA${alignr}${color1}${font Source Sans 3:size=8}${battery_percent BAT0}%  ${battery_status BAT0}${font}${color}
${color4}${hr 1}${color}
${color4}${battery_bar 5,180 BAT0}${color}
]]
